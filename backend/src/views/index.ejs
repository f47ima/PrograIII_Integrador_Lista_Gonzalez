<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

    <main>

        <!-- ===== SECCIÓN LIBROS ===== -->
        <h2>Libros</h2>
        <section class="contenedor-productos">

            <!-- Recorro solo la lista "libros" que mandó el controlador -->
            <% libros.forEach(producto => { %>

                <div class="card-producto">
                    <img class="card-img" src="<%= producto.image %>" alt="<%= producto.name %>">
                    <h4><%= producto.name %></h4>
                    <p><%= producto.author %></p>
                    <p>Id: <%= producto.id %></p>
                    <p>$ <%= producto.price %></p>
                    <!-- Operador ternario: si active es 1 muestra "Activo", si es 0 "Inactivo" -->
                    <p>Estado: <%= producto.active ? "Activo" : "Inactivo" %></p>
                </div>

            <% }) %>

        </section>

        <!-- ===== SECCIÓN CÓMICS ===== -->
        <h2>Cómics</h2>
        <section class="contenedor-productos">

            <% comics.forEach(producto => { %>

                <div class="card-producto">
                    <img class="card-img" src="<%= producto.image %>" alt="<%= producto.name %>">
                    <h4><%= producto.name %></h4>
                    <p><%= producto.author %></p>
                    <p>Id: <%= producto.id %></p>
                    <p>$ <%= producto.price %></p>
                    <p>Estado: <%= producto.active ? "Activo" : "Inactivo" %></p>
                </div>

            <% }) %>

        </section>

    </main>

<%- include("partials/footer.ejs") %>