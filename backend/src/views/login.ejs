<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

    <main>
        <section class="login-container">

            <h2>Ingreso de administradores</h2>
            <p class="texto-suave">Ingresá con tu correo y contraseña para gestionar los productos.</p>

            <% if (error) { %>
                <p class="mensaje error" role="alert"><%= error %></p>
            <% } %>

            <form action="/login" method="post" class="login-form">

                <label for="email">Correo electrónico</label>
                <input type="email" name="email" id="email" value="<%= email %>" autocomplete="username" required>

                <label for="password">Contraseña</label>
                <input type="password" name="password" id="password" autocomplete="current-password" required>

                <input type="submit" value="Ingresar">

                <button type="button" id="acceso-rapido"
                        data-email="<%= adminDemo.email %>" data-password="<%= adminDemo.password %>">
                    Acceso rápido (completar datos de prueba)
                </button>

            </form>

        </section>
    </main>

    <script src="/js/login.js"></script>

<%- include("partials/footer.ejs") %>
